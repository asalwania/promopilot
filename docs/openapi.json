{
  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "properties": {
          "brief": {
            "description": "The brief, in plain English.",
            "maxLength": 2000,
            "title": "Brief",
            "type": "string"
          }
        },
        "required": [
          "brief"
        ],
        "title": "CreateSessionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database",
            "type": "string"
          },
          "model_registry": {
            "enum": [
              "ok",
              "missing"
            ],
            "title": "Model Registry",
            "type": "string"
          }
        },
        "required": [
          "database",
          "model_registry"
        ],
        "title": "HealthChecks",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Mechanism": {
        "enum": [
          "PCT_OFF",
          "BOGO",
          "BUNDLE",
          "FIXED_PRICE"
        ],
        "title": "Mechanism",
        "type": "string"
      },
      "ModelEntry": {
        "description": "One registered model version; `live` marks the one the API is serving.",
        "properties": {
          "as_of_week": {
            "title": "As Of Week",
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/ModelKind"
          },
          "live": {
            "title": "Live",
            "type": "boolean"
          },
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Metrics",
            "type": "object"
          },
          "model_id": {
            "format": "uuid",
            "title": "Model Id",
            "type": "string"
          },
          "trained_at": {
            "format": "date-time",
            "title": "Trained At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "model_id",
          "kind",
          "version",
          "trained_at",
          "as_of_week",
          "metrics",
          "live"
        ],
        "title": "ModelEntry",
        "type": "object"
      },
      "ModelKind": {
        "enum": [
          "demand",
          "relations"
        ],
        "title": "ModelKind",
        "type": "string"
      },
      "ModelList": {
        "description": "Registered models, newest first.",
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelEntry"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "models"
        ],
        "title": "ModelList",
        "type": "object"
      },
      "PlanLine": {
        "description": "A promo option selected into a promo plan: one (SKU, region) decision (ADR 0004).",
        "properties": {
          "bundle_partner_sku_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bundle Partner Sku Id"
          },
          "depth_pct": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Depth Pct",
            "type": "integer"
          },
          "duration_weeks": {
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Duration Weeks",
            "type": "integer"
          },
          "mechanism": {
            "$ref": "#/components/schemas/Mechanism"
          },
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "start_week": {
            "minimum": 0.0,
            "title": "Start Week",
            "type": "integer"
          },
          "target_segment": {
            "$ref": "#/components/schemas/TargetSegment"
          }
        },
        "required": [
          "sku_id",
          "region",
          "mechanism",
          "depth_pct",
          "duration_weeks",
          "start_week",
          "target_segment"
        ],
        "title": "PlanLine",
        "type": "object"
      },
      "PlanRevision": {
        "description": "One numbered version of the promo plan within a planning session.",
        "properties": {
          "lines": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PlanRevisionLine"
            },
            "title": "Lines",
            "type": "array"
          },
          "number": {
            "minimum": 1.0,
            "title": "Number",
            "type": "integer"
          }
        },
        "required": [
          "number"
        ],
        "title": "PlanRevision",
        "type": "object"
      },
      "PlanRevisionLine": {
        "description": "A plan line with the expected numbers the planning tool computed for it (rupees).",
        "properties": {
          "expected_incremental_profit": {
            "title": "Expected Incremental Profit",
            "type": "number"
          },
          "expected_units": {
            "minimum": 0.0,
            "title": "Expected Units",
            "type": "number"
          },
          "line": {
            "$ref": "#/components/schemas/PlanLine"
          },
          "promo_cost": {
            "minimum": 0.0,
            "title": "Promo Cost",
            "type": "number"
          }
        },
        "required": [
          "line",
          "expected_units",
          "promo_cost",
          "expected_incremental_profit"
        ],
        "title": "PlanRevisionLine",
        "type": "object"
      },
      "PlanningRequest": {
        "description": "Money is in rupees (ADR 0015).",
        "properties": {
          "as_of_week": {
            "minimum": 0.0,
            "title": "As Of Week",
            "type": "integer"
          },
          "marketing_budget": {
            "exclusiveMinimum": 0.0,
            "title": "Marketing Budget",
            "type": "number"
          },
          "min_margin": {
            "anyOf": [
              {
                "exclusiveMaximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Margin"
          },
          "promo_window": {
            "$ref": "#/components/schemas/PromoWindow"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          }
        },
        "required": [
          "as_of_week",
          "scope",
          "promo_window",
          "marketing_budget"
        ],
        "title": "PlanningRequest",
        "type": "object"
      },
      "PromoWindow": {
        "description": "The future weeks, inclusive, in which a plan's promotions must start and end.",
        "properties": {
          "end_week": {
            "minimum": 0.0,
            "title": "End Week",
            "type": "integer"
          },
          "start_week": {
            "minimum": 0.0,
            "title": "Start Week",
            "type": "integer"
          }
        },
        "required": [
          "start_week",
          "end_week"
        ],
        "title": "PromoWindow",
        "type": "object"
      },
      "Region": {
        "enum": [
          "North",
          "South",
          "East",
          "West"
        ],
        "title": "Region",
        "type": "string"
      },
      "Scope": {
        "description": "The regions and categories a planning request covers, optionally narrowed to SKUs.",
        "properties": {
          "categories": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Categories",
            "type": "array"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/Region"
            },
            "minItems": 1,
            "title": "Regions",
            "type": "array"
          },
          "sku_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Sku Ids",
            "type": "array"
          }
        },
        "required": [
          "regions",
          "categories"
        ],
        "title": "Scope",
        "type": "object"
      },
      "SessionCreated": {
        "properties": {
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "SessionCreated",
        "type": "object"
      },
      "SessionResponse": {
        "description": "One planning session's read model: status, brief, planning request, latest revision.",
        "properties": {
          "brief": {
            "title": "Brief",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "plan_revision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanRevision"
              },
              {
                "type": "null"
              }
            ]
          },
          "planning_request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanningRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          }
        },
        "required": [
          "session_id",
          "status",
          "brief",
          "planning_request",
          "plan_revision",
          "error"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SessionStatus": {
        "description": "Every status a planning session can have. E3 uses planning, awaiting_approval, failed.",
        "enum": [
          "planning",
          "awaiting_clarification",
          "awaiting_approval",
          "approved",
          "rejected",
          "failed"
        ],
        "title": "SessionStatus",
        "type": "string"
      },
      "TargetSegment": {
        "description": "Who a plan line is offered to: one segment exclusively, or All customers (ADR 0006).",
        "enum": [
          "Value Seekers",
          "Families",
          "Premium",
          "Young Urban",
          "All customers"
        ],
        "title": "TargetSegment",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "PromoPilot API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/models": {
      "get": {
        "operationId": "list_models_api_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "models"
        ]
      }
    },
    "/api/models/retrain": {
      "post": {
        "operationId": "retrain_api_models_retrain_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelEntry"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "A retrain is running or no data"
          }
        },
        "summary": "Retrain",
        "tags": [
          "models"
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "operationId": "create_session_api_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}": {
      "get": {
        "operationId": "get_session_api_sessions__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
