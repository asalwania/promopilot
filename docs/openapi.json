{
  "components": {
    "schemas": {
      "CompetitorGap": {
        "description": "One SKU in one region against the competitor's latest price before the as-of week.",
        "properties": {
          "base_price": {
            "description": "Our regular shelf price in rupees.",
            "title": "Base Price",
            "type": "number"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "competitor_on_promo": {
            "description": "Whether that price was a competitor promo.",
            "title": "Competitor On Promo",
            "type": "boolean"
          },
          "competitor_price": {
            "description": "The competitor's latest price in rupees.",
            "title": "Competitor Price",
            "type": "number"
          },
          "cpi": {
            "description": "Competitor price index: competitor price \u00f7 base price.",
            "title": "Cpi",
            "type": "number"
          },
          "gap": {
            "description": "1 minus CPI: how much cheaper the competitor is (< 0: dearer).",
            "title": "Gap",
            "type": "number"
          },
          "is_kvi": {
            "title": "Is Kvi",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_week": {
            "description": "The week of that price, before the as-of week.",
            "minimum": 0.0,
            "title": "Price Week",
            "type": "integer"
          },
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "subcategory": {
            "title": "Subcategory",
            "type": "string"
          },
          "undercut": {
            "description": "A KVI whose CPI is below 1 minus the undercut threshold.",
            "title": "Undercut",
            "type": "boolean"
          }
        },
        "required": [
          "region",
          "sku_id",
          "name",
          "category",
          "subcategory",
          "is_kvi",
          "base_price",
          "competitor_price",
          "competitor_on_promo",
          "price_week",
          "cpi",
          "gap",
          "undercut"
        ],
        "title": "CompetitorGap",
        "type": "object"
      },
      "CompetitorGaps": {
        "description": "The gaps for a scope, widest first, with the company-policy rules they were judged by.",
        "properties": {
          "as_of_week": {
            "minimum": 0.0,
            "title": "As Of Week",
            "type": "integer"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/CompetitorGap"
            },
            "title": "Gaps",
            "type": "array"
          },
          "kvi_price_tolerance": {
            "description": "How far above the competitor a KVI promo price may sit, when enabled.",
            "title": "Kvi Price Tolerance",
            "type": "number"
          },
          "undercut_threshold": {
            "title": "Undercut Threshold",
            "type": "number"
          }
        },
        "required": [
          "as_of_week",
          "undercut_threshold",
          "kvi_price_tolerance",
          "gaps"
        ],
        "title": "CompetitorGaps",
        "type": "object"
      },
      "Complement": {
        "properties": {
          "lift": {
            "description": "P(both in a basket) / (P(one) x P(other)).",
            "title": "Lift",
            "type": "number"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "std_error": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Std Error"
          },
          "support": {
            "description": "Share of baskets holding both SKUs.",
            "title": "Support",
            "type": "number"
          },
          "theta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cross-price effect, or null if not estimable.",
            "title": "Theta"
          }
        },
        "required": [
          "sku_id",
          "lift",
          "support",
          "theta",
          "std_error"
        ],
        "title": "Complement",
        "type": "object"
      },
      "CreateSessionRequest": {
        "properties": {
          "brief": {
            "description": "The brief, in plain English.",
            "maxLength": 2000,
            "title": "Brief",
            "type": "string"
          }
        },
        "required": [
          "brief"
        ],
        "title": "CreateSessionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database",
            "type": "string"
          },
          "model_registry": {
            "enum": [
              "ok",
              "missing"
            ],
            "title": "Model Registry",
            "type": "string"
          }
        },
        "required": [
          "database",
          "model_registry"
        ],
        "title": "HealthChecks",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Mechanism": {
        "enum": [
          "PCT_OFF",
          "BOGO",
          "BUNDLE",
          "FIXED_PRICE"
        ],
        "title": "Mechanism",
        "type": "string"
      },
      "ModelEntry": {
        "description": "One registered model version; `live` marks the one the API is serving.",
        "properties": {
          "as_of_week": {
            "title": "As Of Week",
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/ModelKind"
          },
          "live": {
            "title": "Live",
            "type": "boolean"
          },
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Metrics",
            "type": "object"
          },
          "model_id": {
            "format": "uuid",
            "title": "Model Id",
            "type": "string"
          },
          "trained_at": {
            "format": "date-time",
            "title": "Trained At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "model_id",
          "kind",
          "version",
          "trained_at",
          "as_of_week",
          "metrics",
          "live"
        ],
        "title": "ModelEntry",
        "type": "object"
      },
      "ModelKind": {
        "enum": [
          "demand",
          "relations"
        ],
        "title": "ModelKind",
        "type": "string"
      },
      "ModelList": {
        "description": "Registered models, newest first.",
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelEntry"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "models"
        ],
        "title": "ModelList",
        "type": "object"
      },
      "ModelVersion": {
        "description": "The registered model that produced the numbers, so a plan can be traced to it.",
        "properties": {
          "as_of_week": {
            "title": "As Of Week",
            "type": "integer"
          },
          "model_id": {
            "format": "uuid",
            "title": "Model Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "model_id",
          "version",
          "as_of_week"
        ],
        "title": "ModelVersion",
        "type": "object"
      },
      "PlanLine": {
        "description": "A promo option selected into a promo plan: one (SKU, region) decision (ADR 0004).",
        "properties": {
          "bundle_partner_sku_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bundle Partner Sku Id"
          },
          "depth_pct": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Depth Pct",
            "type": "integer"
          },
          "duration_weeks": {
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Duration Weeks",
            "type": "integer"
          },
          "mechanism": {
            "$ref": "#/components/schemas/Mechanism"
          },
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "start_week": {
            "minimum": 0.0,
            "title": "Start Week",
            "type": "integer"
          },
          "target_segment": {
            "$ref": "#/components/schemas/TargetSegment"
          }
        },
        "required": [
          "sku_id",
          "region",
          "mechanism",
          "depth_pct",
          "duration_weeks",
          "start_week",
          "target_segment"
        ],
        "title": "PlanLine",
        "type": "object"
      },
      "PlanRevision": {
        "description": "One numbered version of the promo plan within a planning session.",
        "properties": {
          "lines": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PlanRevisionLine"
            },
            "title": "Lines",
            "type": "array"
          },
          "number": {
            "minimum": 1.0,
            "title": "Number",
            "type": "integer"
          }
        },
        "required": [
          "number"
        ],
        "title": "PlanRevision",
        "type": "object"
      },
      "PlanRevisionLine": {
        "description": "A plan line with the expected numbers the planning tool computed for it (rupees).",
        "properties": {
          "expected_incremental_profit": {
            "title": "Expected Incremental Profit",
            "type": "number"
          },
          "expected_units": {
            "minimum": 0.0,
            "title": "Expected Units",
            "type": "number"
          },
          "line": {
            "$ref": "#/components/schemas/PlanLine"
          },
          "promo_cost": {
            "minimum": 0.0,
            "title": "Promo Cost",
            "type": "number"
          }
        },
        "required": [
          "line",
          "expected_units",
          "promo_cost",
          "expected_incremental_profit"
        ],
        "title": "PlanRevisionLine",
        "type": "object"
      },
      "PlanningRequest": {
        "description": "Money is in rupees (ADR 0015).",
        "properties": {
          "as_of_week": {
            "minimum": 0.0,
            "title": "As Of Week",
            "type": "integer"
          },
          "marketing_budget": {
            "exclusiveMinimum": 0.0,
            "title": "Marketing Budget",
            "type": "number"
          },
          "min_margin": {
            "anyOf": [
              {
                "exclusiveMaximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Margin"
          },
          "promo_window": {
            "$ref": "#/components/schemas/PromoWindow"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          }
        },
        "required": [
          "as_of_week",
          "scope",
          "promo_window",
          "marketing_budget"
        ],
        "title": "PlanningRequest",
        "type": "object"
      },
      "PromoWindow": {
        "description": "The future weeks, inclusive, in which a plan's promotions must start and end.",
        "properties": {
          "end_week": {
            "minimum": 0.0,
            "title": "End Week",
            "type": "integer"
          },
          "start_week": {
            "minimum": 0.0,
            "title": "Start Week",
            "type": "integer"
          }
        },
        "required": [
          "start_week",
          "end_week"
        ],
        "title": "PromoWindow",
        "type": "object"
      },
      "Region": {
        "enum": [
          "North",
          "South",
          "East",
          "West"
        ],
        "title": "Region",
        "type": "string"
      },
      "RelationsResponse": {
        "description": "A SKU's substitutes (strongest first) and complements (highest lift first).",
        "properties": {
          "complements": {
            "items": {
              "$ref": "#/components/schemas/Complement"
            },
            "title": "Complements",
            "type": "array"
          },
          "model": {
            "$ref": "#/components/schemas/ModelVersion"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "substitutes": {
            "items": {
              "$ref": "#/components/schemas/Substitute"
            },
            "title": "Substitutes",
            "type": "array"
          }
        },
        "required": [
          "model",
          "sku_id",
          "substitutes",
          "complements"
        ],
        "title": "RelationsResponse",
        "type": "object"
      },
      "Scope": {
        "description": "The regions and categories a planning request covers, optionally narrowed to SKUs.",
        "properties": {
          "categories": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Categories",
            "type": "array"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/Region"
            },
            "minItems": 1,
            "title": "Regions",
            "type": "array"
          },
          "sku_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Sku Ids",
            "type": "array"
          }
        },
        "required": [
          "regions",
          "categories"
        ],
        "title": "Scope",
        "type": "object"
      },
      "SessionCreated": {
        "properties": {
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "SessionCreated",
        "type": "object"
      },
      "SessionResponse": {
        "description": "One planning session's read model: status, brief, planning request, latest revision.",
        "properties": {
          "brief": {
            "title": "Brief",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "plan_revision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanRevision"
              },
              {
                "type": "null"
              }
            ]
          },
          "planning_request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanningRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          }
        },
        "required": [
          "session_id",
          "status",
          "brief",
          "planning_request",
          "plan_revision",
          "error"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SessionStatus": {
        "description": "Every status a planning session can have. E3 uses planning, awaiting_approval, failed.",
        "enum": [
          "planning",
          "awaiting_clarification",
          "awaiting_approval",
          "approved",
          "rejected",
          "failed"
        ],
        "title": "SessionStatus",
        "type": "string"
      },
      "Substitute": {
        "properties": {
          "q_value": {
            "title": "Q Value",
            "type": "number"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "std_error": {
            "title": "Std Error",
            "type": "number"
          },
          "theta": {
            "description": "Cross-price effect: positive for a substitute.",
            "title": "Theta",
            "type": "number"
          }
        },
        "required": [
          "sku_id",
          "theta",
          "std_error",
          "q_value"
        ],
        "title": "Substitute",
        "type": "object"
      },
      "TargetSegment": {
        "description": "Who a plan line is offered to: one segment exclusively, or All customers (ADR 0006).",
        "enum": [
          "Value Seekers",
          "Families",
          "Premium",
          "Young Urban",
          "All customers"
        ],
        "title": "TargetSegment",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "PromoPilot API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/competitors/gaps": {
      "get": {
        "description": "Competitor price index, gap and KVI undercut per SKU x region, widest gap first.\n\nAn unknown category is 422.",
        "operationId": "competitor_gaps_api_competitors_gaps_get",
        "parameters": [
          {
            "description": "Defaults to the data's default as-of week.",
            "in": "query",
            "name": "as_of_week",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the data's default as-of week.",
              "title": "As Of Week"
            }
          },
          {
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Region"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "kvi_only",
            "required": false,
            "schema": {
              "default": false,
              "title": "Kvi Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitorGaps"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "No data is loaded"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Competitor Gaps",
        "tags": [
          "competitors"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/models": {
      "get": {
        "operationId": "list_models_api_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "models"
        ]
      }
    },
    "/api/models/retrain": {
      "post": {
        "operationId": "retrain_api_models_retrain_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelEntry"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "A retrain is running or no data"
          }
        },
        "summary": "Retrain",
        "tags": [
          "models"
        ]
      }
    },
    "/api/relations/{sku_id}": {
      "get": {
        "operationId": "get_relations_api_relations__sku_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "sku_id",
            "required": true,
            "schema": {
              "title": "Sku Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such SKU"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "No relations model fitted on the live demand model"
          }
        },
        "summary": "Get Relations",
        "tags": [
          "relations"
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "operationId": "create_session_api_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session",
        "tags": [
          "sessions"
        ]
