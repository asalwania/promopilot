      },
      "SelectionReasonCode": {
        "description": "A positive part of a plan line's value (ADR 0005, ADR 0035).",
        "enum": [
          "incremental_profit",
          "clearance_value",
          "halo"
        ],
        "title": "SelectionReasonCode",
        "type": "string"
      },
      "SessionCreated": {
        "properties": {
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "SessionCreated",
        "type": "object"
      },
      "SessionResponse": {
        "description": "One planning session's read model: status, brief, planning request, latest revision.",
        "properties": {
          "brief": {
            "title": "Brief",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "plan_revision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanRevision"
              },
              {
                "type": "null"
              }
            ]
          },
          "planning_request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanningRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          }
        },
        "required": [
          "session_id",
          "status",
          "brief",
          "planning_request",
          "plan_revision",
          "error"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SessionStatus": {
        "description": "Every status a planning session can have. E3 uses planning, awaiting_approval, failed.",
        "enum": [
          "planning",
          "awaiting_clarification",
          "awaiting_approval",
          "approved",
          "rejected",
          "failed"
        ],
        "title": "SessionStatus",
        "type": "string"
      },
      "SolveStatus": {
        "enum": [
          "OPTIMAL",
          "FEASIBLE",
          "INFEASIBLE"
        ],
        "title": "SolveStatus",
        "type": "string"
      },
      "Store": {
        "properties": {
          "city": {
            "title": "City",
            "type": "string"
          },
          "segment_mix": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Segment"
            },
            "title": "Segment Mix",
            "type": "object"
          },
          "store_id": {
            "title": "Store Id",
            "type": "string"
          }
        },
        "required": [
          "store_id",
          "city",
          "segment_mix"
        ],
        "title": "Store",
        "type": "object"
      },
      "Substitute": {
        "properties": {
          "q_value": {
            "title": "Q Value",
            "type": "number"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "std_error": {
            "title": "Std Error",
            "type": "number"
          },
          "theta": {
            "description": "Cross-price effect: positive for a substitute.",
            "title": "Theta",
            "type": "number"
          }
        },
        "required": [
          "sku_id",
          "theta",
          "std_error",
          "q_value"
        ],
        "title": "Substitute",
        "type": "object"
      },
      "TargetSegment": {
        "description": "Who a plan line is offered to: one segment exclusively, or All customers (ADR 0006).",
        "enum": [
          "Value Seekers",
          "Families",
          "Premium",
          "Young Urban",
          "All customers"
        ],
        "title": "TargetSegment",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhyChosen": {
        "description": "Why a plan line was chosen: the positive parts of its value, what it is worth alone,\nand whether it is the best option the optimiser could pick for its SKU and region.",
        "properties": {
          "best_for_sku_region": {
            "title": "Best For Sku Region",
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/SelectionReason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "reasons",
          "value",
          "best_for_sku_region"
        ],
        "title": "WhyChosen",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "PromoPilot API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/catalog/products": {
      "get": {
        "description": "Every product in SKU order; an unknown category is 422.",
        "operationId": "list_products_api_catalog_products_get",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "kvi_only",
            "required": false,
            "schema": {
              "default": false,
              "title": "Kvi Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Products",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/catalog/regions": {
      "get": {
        "description": "Each region's stores with their customer segment mix.",
        "operationId": "list_regions_api_catalog_regions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Regions",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/competitors/gaps": {
      "get": {
        "description": "Competitor price index, gap and KVI undercut per SKU x region, widest gap first.\n\nAn unknown category is 422.",
        "operationId": "competitor_gaps_api_competitors_gaps_get",
        "parameters": [
          {
            "description": "Defaults to the data's default as-of week.",
            "in": "query",
            "name": "as_of_week",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the data's default as-of week.",
              "title": "As Of Week"
            }
          },
          {
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Region"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "kvi_only",
            "required": false,
            "schema": {
              "default": false,
              "title": "Kvi Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitorGaps"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "No data is loaded"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Competitor Gaps",
        "tags": [
          "competitors"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/inventory": {
      "get": {
        "description": "Stock per SKU x region pooled over the region's stores, with overstock flags.\n\nAn unknown category, or a region without stores, is 422.",
        "operationId": "inventory_api_inventory_get",
        "parameters": [
          {
            "description": "Defaults to the data's default as-of week.",
            "in": "query",
            "name": "as_of_week",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the data's default as-of week.",
              "title": "As Of Week"
            }
          },
          {
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Region"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "overstocked_only",
            "required": false,
            "schema": {
              "default": false,
              "title": "Overstocked Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "No data is loaded for the week"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Inventory",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/models": {
      "get": {
        "operationId": "list_models_api_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Models",
        "tags": [
          "models"
        ]
      }
    },
    "/api/models/retrain": {
      "post": {
        "operationId": "retrain_api_models_retrain_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelEntry"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "A retrain is running or no data"
          }
        },
        "summary": "Retrain",
        "tags": [
          "models"
        ]
      }
    },
    "/api/relations/{sku_id}": {
      "get": {
        "operationId": "get_relations_api_relations__sku_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "sku_id",
            "required": true,
            "schema": {
              "title": "Sku Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such SKU"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "No relations model fitted on the live demand model"
          }
        },
        "summary": "Get Relations",
        "tags": [
          "relations"
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "operationId": "create_session_api_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{session_id}": {
      "get": {
        "operationId": "get_session_api_sessions__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
