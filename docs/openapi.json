{
  "components": {
    "schemas": {
      "BindingConstraint": {
        "description": "A constraint that limits the plan: dropping it gives a strictly better objective, or,\nwhen time ran out, one that may.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "evidence": {
            "$ref": "#/components/schemas/BindingEvidence"
          },
          "kind": {
            "$ref": "#/components/schemas/ConstraintKind"
          },
          "limit": {
            "title": "Limit",
            "type": "number"
          },
          "objective_gain": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Objective Gain"
          },
          "region": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Region"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/components/schemas/ConstraintSource"
          }
        },
        "required": [
          "kind",
          "source",
          "limit",
          "evidence",
          "objective_gain"
        ],
        "title": "BindingConstraint",
        "type": "object"
      },
      "BindingEvidence": {
        "description": "How sure the optimiser is that a constraint binds (ADR 0038).",
        "enum": [
          "exact",
          "lower_bound",
          "unproven"
        ],
        "title": "BindingEvidence",
        "type": "string"
      },
      "CompetitorGap": {
        "description": "One SKU in one region against the competitor's latest price before the as-of week.",
        "properties": {
          "base_price": {
            "description": "Our regular shelf price in rupees.",
            "title": "Base Price",
            "type": "number"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "competitor_on_promo": {
            "description": "Whether that price was a competitor promo.",
            "title": "Competitor On Promo",
            "type": "boolean"
          },
          "competitor_price": {
            "description": "The competitor's latest price in rupees.",
            "title": "Competitor Price",
            "type": "number"
          },
          "cpi": {
            "description": "Competitor price index: competitor price \u00f7 base price.",
            "title": "Cpi",
            "type": "number"
          },
          "gap": {
            "description": "1 minus CPI: how much cheaper the competitor is (< 0: dearer).",
            "title": "Gap",
            "type": "number"
          },
          "is_kvi": {
            "title": "Is Kvi",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_week": {
            "description": "The week of that price, before the as-of week.",
            "minimum": 0.0,
            "title": "Price Week",
            "type": "integer"
          },
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "subcategory": {
            "title": "Subcategory",
            "type": "string"
          },
          "undercut": {
            "description": "A KVI whose CPI is below 1 minus the undercut threshold.",
            "title": "Undercut",
            "type": "boolean"
          }
        },
        "required": [
          "region",
          "sku_id",
          "name",
          "category",
          "subcategory",
          "is_kvi",
          "base_price",
          "competitor_price",
          "competitor_on_promo",
          "price_week",
          "cpi",
          "gap",
          "undercut"
        ],
        "title": "CompetitorGap",
        "type": "object"
      },
      "CompetitorGaps": {
        "description": "The gaps for a scope, widest first, with the company-policy rules they were judged by.",
        "properties": {
          "as_of_week": {
            "minimum": 0.0,
            "title": "As Of Week",
            "type": "integer"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/CompetitorGap"
            },
            "title": "Gaps",
            "type": "array"
          },
          "kvi_price_tolerance": {
            "description": "How far above the competitor a KVI promo price may sit, when enabled.",
            "title": "Kvi Price Tolerance",
            "type": "number"
          },
          "undercut_threshold": {
            "title": "Undercut Threshold",
            "type": "number"
          }
        },
        "required": [
          "as_of_week",
          "undercut_threshold",
          "kvi_price_tolerance",
          "gaps"
        ],
        "title": "CompetitorGaps",
        "type": "object"
      },
      "Complement": {
        "properties": {
          "lift": {
            "description": "P(both in a basket) / (P(one) x P(other)).",
            "title": "Lift",
            "type": "number"
          },
          "sku_id": {
            "title": "Sku Id",
            "type": "string"
          },
          "std_error": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Std Error"
          },
          "support": {
            "description": "Share of baskets holding both SKUs.",
            "title": "Support",
            "type": "number"
          },
          "theta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cross-price effect, or null if not estimable.",
            "title": "Theta"
          }
        },
        "required": [
          "sku_id",
          "lift",
          "support",
          "theta",
          "std_error"
        ],
        "title": "Complement",
        "type": "object"
      },
      "ConstraintKind": {
        "description": "A plan-level constraint the optimiser enforces (ADR 0036, ADR 0038).",
        "enum": [
          "marketing_budget",
          "minimum_margin",
          "margin_floor",
          "max_promoted_skus"
        ],
        "title": "ConstraintKind",
        "type": "string"
      },
      "ConstraintSource": {
        "description": "Who set a constraint: only the brief's constraints may be relaxed (ADR 0007).",
        "enum": [
          "brief",
          "company_policy"
        ],
        "title": "ConstraintSource",
        "type": "string"
      },
      "CreateSessionRequest": {
        "properties": {
