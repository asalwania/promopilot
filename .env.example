# Copy to .env (`make setup` does this). Never commit .env.

# Postgres (docker compose service `postgres`)
POSTGRES_USER=promopilot
POSTGRES_PASSWORD=promopilot
POSTGRES_DB=promopilot
POSTGRES_PORT=5432

# Backend: async SQLAlchemy URL. Inside docker compose the host is overridden to `postgres`.
# The agent graph's checkpointer uses the same database through psycopg 3 (ADR 0046).
DATABASE_URL=postgresql+asyncpg://promopilot:promopilot@localhost:5432/promopilot
API_PORT=8000

# Frontend: where the Next.js server forwards same-origin /api/* requests
# (the browser never calls the API directly). Docker Compose uses http://api:8000.
API_URL=http://localhost:8000
WEB_PORT=3000

# Synthetic data (make data): where generated/ and ground_truth/ are written.
# Relative paths are from backend/.
DATA_DIR=../data

# Trained models (make train): artifacts go here, the registry rows go to Postgres.
# Relative paths are from backend/. Docker Compose uses a volume at /app/models.
MODEL_DIR=../models

# Eval reports (ADR 0069): where GET /api/evals/latest reads the latest.json that `make eval`
# writes. Relative paths are from backend/. The Docker stack mounts none, so it answers 404.
EVAL_REPORT_DIR=evals/reports

# LLM layer (ADR 0001, ADR 0019, ADR 0027). `replay` answers from committed cassettes and needs no key.
# LLM_PROVIDER: replay | openai | anthropic  (fake is test-only). The other live provider is
# the fallback when its key and model are set too; replay never falls back.
LLM_PROVIDER=replay
# Recorded responses, one JSON file per request hash. Relative paths are from backend/.
LLM_CASSETTE_DIR=cassettes
# Only for LLM_PROVIDER=openai and `make record-cassettes`. Put the real key in .env only;
# never commit it. The model must accept temperature 0, e.g. gpt-4.1-mini (ADR 0022).
# Docker Compose ignores these: its api always replays the baked-in cassettes.
OPENAI_API_KEY=
OPENAI_MODEL=
# Only for LLM_PROVIDER=anthropic, or as the fallback when OpenAI is primary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Per-session cost (ADR 0027). Leave unset for the built-in prices of gpt-4.1-mini and
# claude-sonnet-5. LLM_PRICES replaces the whole table, in US dollars per million tokens, e.g.
# LLM_PRICES={"gpt-4.1-mini":{"input_usd_per_mtok":0.4,"output_usd_per_mtok":1.6}}
# USD_INR_RATE=96

# Live trace (ADR 0047): how often an open SSE trace stream looks for new events, in seconds,
# and the API's log lines: json (one object per line, with the session id) or console.
TRACE_POLL_INTERVAL_S=0.5
LOG_FORMAT=json

# CP-SAT optimiser (ADR 0036). One worker and a fixed seed keep plans reproducible; more
# workers interleave their search deterministically. Each phase stops on a budget of CP-SAT
# deterministic seconds (work done, the same on any machine), so a plan never depends on how
# fast or busy the machine is; the *_TIME_LIMIT_SECONDS are wall-clock safety nets a healthy
# machine never reaches (ADR 0055). Recorded cassettes replay only with the budgets they were
# recorded with (ADR 0054).
OPTIMIZER_DETERMINISTIC_LIMIT=10
OPTIMIZER_TIME_LIMIT_SECONDS=60
OPTIMIZER_WORKERS=1
OPTIMIZER_SEED=0
# Proving which constraints bind, after the solve (ADR 0038); a constraint left unsettled when
# the budget runs out is reported as unproven. 0 turns the analysis off.
OPTIMIZER_BINDING_DETERMINISTIC_LIMIT=6
OPTIMIZER_BINDING_TIME_LIMIT_SECONDS=30
# Finding the smallest relaxation of an infeasible request's brief constraints (ADR 0044);
# only a request no plan can reach every clearance target of uses it.
OPTIMIZER_RELAXATION_DETERMINISTIC_LIMIT=10
OPTIMIZER_RELAXATION_TIME_LIMIT_SECONDS=60

# Monte Carlo simulation of every plan revision (ADR 0042). SIMULATION_RUNS is 100-5000 and is
# also the simulate_plan tool's default; the fixed seed makes every simulation reproducible.
SIMULATION_RUNS=1000
SIMULATION_SEED=0

# The Critic's risk review (ADR 0051): flag a plan line above this share of the plan's promo
# spend (a category or region above the group share, when the scope has several), cannibalisation
# at or above this share of a line's incremental profit, and a line that runs out of stock in at
# least this share of simulated runs. Findings go back to the planner agent at most 3 times.
CRITIC_LINE_SPEND_SHARE=0.25
CRITIC_GROUP_SPEND_SHARE=0.8
CRITIC_CANNIBALISATION_SHARE=0.5
CRITIC_STOCKOUT_PROBABILITY=0.2
